{
  "name": "kinobot-backend",
  "version": "2.0.0",
  "description": "KinoBot Telegram Mini App, local database and Telegram backups",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:all": "node start-all.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "db:migrate": "node scripts/db-migrate.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "bot": "node bot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "telegram": "^2.26.22"
  }
}
