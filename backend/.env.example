# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring

# Server porti
PORT=3000

# ---- Ma'lumotlar bazasi (ixtiyoriy, lekin Render bepul tarifida TAVSIYA ETILADI) ----
# Bo'sh bo'lsa: data/db.json fayliga saqlanadi (Render bepul tarifda restart/
#   deploy'da diskning o'zi tozalanadi — ma'lumot yo'qoladi).
# To'ldirilsa: Neon (yoki boshqa Postgres) xizmatiga saqlanadi — Render qayta
#   ishga tushsa ham ma'lumot yo'qolmaydi.
# Neon'da loyiha ochib, "Connection string"ni shu yerga qo'ying:
# DATABASE_URL=postgresql://user:parol@ep-xxx.neon.tech/dbname?sslmode=require
#
# Mavjud data/db.json'ni Neon'ga bir martalik ko'chirish:
#   npm run db:migrate-to-postgres
DATABASE_URL=

# ---- Poster/banner rasmlari (ixtiyoriy, lekin TAVSIYA ETILADI) ----
# Ustuvorlik: Firebase Storage (sozlangan bo'lsa) → Postgres (DATABASE_URL) → disk.
# Neon bepul tarifi atigi 500MB bergani uchun, postelar tez to'lib
# ketmasligi uchun Firebase Storage'ni ishlatish tavsiya etiladi (bepul
# tarifi 5GB, Google'ning o'zi, O'zbekistonda muammosiz ishlaydi —
# Cloudinary O'zbekistonda ISHLAMAYDI, shuning uchun u ishlatilmaydi).
#
# Sozlash (Google akkaunt bilan, bepul):
# 1) https://console.firebase.google.com -> "Add project" -> loyiha yarating
# 2) Chap menyu -> Build -> Storage -> "Get started" (Storage'ni yoqing)
# 3) Chap menyu -> Project settings (tishli g'ildirak) -> Service accounts
#    -> "Generate new private key" -> JSON fayl yuklab olinadi
# 4) O'sha JSON fayldan quyidagilarni ko'chiring:
#    - "client_email"  -> FIREBASE_CLIENT_EMAIL
#    - "private_key"   -> FIREBASE_PRIVATE_KEY (BUTUN qatorni, \n belgilari
#      bilan birga, ikki tirnoq ichida qo'ying — quyidagi namunadagidek)
#    - Project settings -> General -> "Storage bucket" (odatda
#      loyiha-nomi.appspot.com) -> FIREBASE_STORAGE_BUCKET
# Namuna:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Ishlab chiqarish rejimi: production qilib qo'ysangiz, qat'iy CORS + admin tekshiruvi faollashadi
# NODE_ENV=production

# Dev-mode: yoqilsa, Telegram initData'siz ?userId= orqali kirish mumkin bo'ladi.
# FAQAT lokal rivojlantirish uchun — production'da HECH QACHON yoqmang.
# Standart holatda O'CHIQ (xavfsiz tomonga fail-open emas, fail-closed).
DEV_MODE=1

# BotFather bergan bot tokeni (Telegram initData'ni tekshirish uchun MAJBURIY)
# Masalan: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# Admin: Telegram user ID (tavsiya etilgan usul).
# Sizning Telegram ID'ingizni bot orqali bilib oling (masalan /myid yoki @userinfobot).
# Bu qiymat o'rnatilgan bo'lsa, faqat shu user /admin va admin API'larga kira oladi.
# ADMIN_ID=123456789

# Admin: muqobil maxfiy kalit (X-Admin-Key header orqali yuboriladi).
# DIQQAT: standart qiymat YO'Q. Production'da majburan o'rnatilishi kerak,
# aks holda admin endpointlari 503 (CONFIG_ERROR) qaytaradi.
ADMIN_KEY=

# Webapp joylashgan HTTPS manzil (bot.js shu manzilni /start tugmasida ishlatadi)
# Masalan: https://sizning-domen.com  yoki https://xxxx.trycloudflare.com
WEBAPP_URL=

# Kanal ID (bot.js kanal-kod va broadcast xususiyati uchun). Format:
# @kanalusername yoki -100xxxxxxxxxx (bot shu kanalda admin bo'lishi kerak).
#   - Kanalga "#1" (yoki "#VIP2" kabi) caption bilan video yuborilsa,
#     bot uni "1" kodiga bog'laydi. Foydalanuvchi botga "1" deb yozsa,
#     bot o'sha videoni copyMessage orqali yuboradi (qayta yuklamaydi).
#   - Kanalga "*" bilan boshlangan istalgan xabar/rasm yuborilsa,
#     bot uni botning barcha (bloklanmagan) foydalanuvchilariga yuboradi.
# Masalan: CHANNEL_ID=@kinobot_channel  yoki  CHANNEL_ID=-1001234567890
# CHANNEL_ID=

# CORS ruxsat berilgan originlar (vergul bilan ajratiladi).
# Production'da to'ldirilishi kerak, aks holda faqat o'z originiga ruxsat beriladi.
# Masalan: ALLOWED_ORIGINS=https://sizning-domen.com,https://xxxx.trycloudflare.com
# ALLOWED_ORIGINS=

# ---- Video storage ----
# Ikki rejim:
#
#   LOKAL (standart, Cloudflare shart emas):
#   R2 key'lari bo'sh bo'lsa, video fayllar kompyuterdagi
#   `backend/data/videos/{filmId}/{quality}.mp4` papkasiga saqlanadi.
#   Upload ham, player ham shu holda ishlaydi. Test uchun shu rejimni ishlating.
#
#   CLOUDFLARE R2:
#   Quyidagi 4 qiymat to'ldirilsa, video fayllar R2'ga saqlanadi.
# 1) Cloudflare dashboards -> R2 -> bucket yarating (masalan "kinobot-videos", PRIVATE).
# 2) R2 -> Manage R2 API Tokens -> token yarating:
#    - Permission: Object Read & Write (faqat shu bucket uchun)
#    - Access Key ID va Secret Access Key'larni saqlang (faqat bir marta ko'rsatiladi!)
# 3) Quyidagilarni to'ldiring:
CLOUDFLARE_ACCOUNT_ID=

# Kali lokal video saqlash papkasi (R2 o'rniga alternativ yoki fallback).
# R2 sozlanmaganida video fayllar shu papkaga saqlanadi va HTTP Range bilan
# xizmat qilinadi. Har bir film alohida papkada: {papka}/{filmId}/{quality}.mp4
LOCAL_VIDEOS_DIR=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---- Telegram kanaldan-kanalga avtomatik video saqlash (ixtiyoriy) ----
# CHANNEL_ID (yuqorida) ga video tashlanganda, uni alohida "storage"
# kanalga avtomatik nusxalaydi (Bot API'ning 20MB cheklovisiz, MTProto
# orqali). Bu 3 ta qiymat TO'LDIRILMASA — xususiyat butunlay o'chiq,
# boshqa hech narsa o'zgarmaydi.
#
# 1) https://my.telegram.org -> API development tools -> ilova yarating
#    (bepul, istalgan Telegram akkaunt bilan; bu shunchaki "ilova ID"si,
#    alohida login talab qilmaydi — bot o'zining BOT_TOKEN'i bilan kiradi).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 2) Storage kanal yarating (yashirin/xususiy bo'lishi mumkin), botni
#    o'sha kanalga ADMIN qilib qo'shing, ID'sini shu yerga yozing
#    (masalan -1009876543210).
STORAGE_CHANNEL_ID=

# 3) (ixtiyoriy) Video-strimni bir nechta bot-sessiya orasida taqsimlash —
#    ko'p odam bir vaqtda kino ko'rsa Telegram flood-control (FLOOD_WAIT)
#    tezroq ishga tushmasligi uchun. Asosiy BOT_TOKEN ham avtomatik
#    ravishda pool'ga kiradi (0-indeks) — bu yerga FAQAT qo'shimcha
#    tokenlarni yozing.
#    Har bir qo'shimcha token uchun:
#      - @BotFather orqali yangi bot yarating
#      - shu botni ham STORAGE_CHANNEL_ID kanaliga a'zo (admin) qilib qo'shing
#      - tokenni pastga vergul bilan ajratib qo'shing
#    TELEGRAM_API_ID / TELEGRAM_API_HASH BARCHA sessiyalar uchun bir xil
#    qoladi — alohida akkaunt/login shart emas.
#    Bo'sh qoldirilsa — bitta (asosiy) sessiya bilan avvalgidek ishlaydi.
# Masalan: STREAM_BOT_TOKENS=111111:AAA...,222222:BBB...,333333:CCC...
STREAM_BOT_TOKENS=
