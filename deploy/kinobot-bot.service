# KinoBot Bot — systemd xizmati (Telegram long-polling)
#
# O'rnatish:
#   sudo cp deploy/kinobot-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kinobot-bot
#
# Holatni tekshirish:   systemctl status kinobot-bot
# Loglarni ko'rish:     journalctl -u kinobot-bot -f
#
# DIQQAT: quyidagi yo'llarni o'zingizning server tuzilmangizga moslang:
#   1) ExecStart dagi node.js yo'li  (tekshirish: `which node`)
#   2) WorkingDirectory (proyekt joylashgan papka)

[Unit]
Description=KinoBot Telegram bot (backend/bot.js — long polling)
Documentation=https://github.com/your-user/kinobot-project
After=network-online.target kinobot-api.service
Wants=network-online.target

[Service]
Type=simple

# O'zingizning yo'llaringizga almashtiring:
ExecStart=/usr/bin/node /opt/kinobot/backend/bot.js
WorkingDirectory=/opt/kinobot/backend

# .env fayli WorkingDirectory dan o'qiladi (bot.js avtomatik yuklaydi).
EnvironmentFile=/opt/kinobot/backend/.env

# Bot jarayoni tushsa yoki tarmoq xatosi bo'lsa qayta ishga tushadi
Restart=on-failure
RestartSec=5

# Xavfsizlik: non-root foydalanuvchi
User=kinobot
Group=kinobot

# SIGINT/SIGTERM bilan toza yopilish (Task6'da qo'shiladi)
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinobot-bot

[Install]
WantedBy=multi-user.target
